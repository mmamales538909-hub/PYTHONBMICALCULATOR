
while True:
    print("\n---  BMI Calculator ---")
    print("1. Check My BMI")
    print("2. View BMI Categories")
    print("3. Quit")

    choice = input("Select an option (1-3): ")

    if choice == "1":
        name = input("Your name: ")
        weight = float(input("Weight (kg): "))
        height = float(input("Height (m): "))

        # Validation check
        if weight <= 0 or height <= 0:
            print("Error: Weight and height must be greater than zero.")
        else:
            bmi = weight / (height * height)

            # Category evaluation
            if bmi < 18.5:
                category = "Underweight"
            elif bmi < 25.0:
                category = "Normal weight"
            elif bmi < 30.0:
                category = "Overweight"
            else:
                category = "Obesity"

            # Formatted report
            print(f"\n=======================")
            print(f"  BMI SUMMARY: {name.upper()}")
            print(f"=======================")
            print(f"Recorded Weight : {weight} kg")
            print(f"Recorded Height : {height} m")
            print(f"Calculated BMI  : {bmi:.2f}")
            print(f"Category   : {category}")
            print(f"=======================")

    elif choice == "2":
        print("\n--- STANDARD BMI RANGES ---")
        print(f"{'BMI Range':<20} | {'Category'}")
        print("-" * 35)
        print(f"{'Below 18.5':<20} | Underweight")
        print(f"{'18.5 to below 25':<20} | Normal weight")
        print(f"{'25 to below 30':<20} | Overweight")
        print(f"{'30 and above':<20} | Obesity")

    elif choice == "3":
        print("Thank you for using the BMI Calculator!")
        break

    else:
        print("Invalid choice. Please select 1, 2, or 3.")
